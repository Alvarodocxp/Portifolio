# Configurações do serviço de e-mail (EmailJS)
# Crie uma conta gratuita em https://www.emailjs.com/ e copie os valores:
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Chave da API do Google Gemini (Gratuita para IA Generativa no Ask)
# Obtenha sua chave gratuita em https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
